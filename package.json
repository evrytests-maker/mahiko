{
  "name": "mohiko",
  "version": "0.1.0",
  "private": true,
  "description": "A buildable Electron integration workspace for OMP 17.2.9",
  "homepage": "https://github.com/evrytests-maker/mohiko",
  "author": {
    "name": "evrytests-maker",
    "email": "evrytests-maker@users.noreply.github.com"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "check:omp": "npm run build:main && node scripts/check-omp.mjs",
    "pack:linux": "npm run build && electron-builder --linux dir --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm tar.gz --x64",
    "start": "electron ."
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.github.evrytestsmaker.mohiko",
    "productName": "Mohiko",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "omp.lock.json",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ]
    }
  }
}
